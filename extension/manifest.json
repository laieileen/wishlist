{
    "manifest_version": 3,
    "name": "Keepsake",
    "version": "1.0",
    "description": "Save finds to your personal wishlist",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Save to Keepsake"
    },
    "host_permissions": [
        "https://wishlist-yu2x.onrender.com/*",
        "https://identitytoolkit.googleapis.com/*",
        "https://securetoken.googleapis.com/*"
    ]
}